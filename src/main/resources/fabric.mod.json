{
  "schemaVersion": 1,
  "id": "nocturne",
  "version": "${version}",
  "name": "Nocturne",
  "description": "Cinematic lyrics in your Minecraft world, with automatic desktop music detection. No login required.",
  "authors": [
    "Truwty"
  ],
  "license": "ARR",
  "icon": "assets/nocturne/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.truwty.nocturne.NocturneClient"
    ],
    "modmenu": [
      "dev.truwty.nocturne.maintenance.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "nocturne.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.155.3"
  },
  "contact": {
    "homepage": "https://github.com/Truwty/nocturne",
    "sources": "https://github.com/Truwty/nocturne",
    "issues": "https://github.com/Truwty/nocturne/issues"
  },
  "suggests": {
    "modmenu": ">=18.0.2"
  }
}
